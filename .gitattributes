# Normalize line endings across Windows/Linux/macOS
* text=auto

# Force LF for source files
*.cs text eol=lf
*.csx text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.resx text eol=lf
*.cshtml text eol=lf
*.razor text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.dockerfile text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
