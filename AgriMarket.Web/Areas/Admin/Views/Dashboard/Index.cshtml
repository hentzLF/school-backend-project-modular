@model DashboardViewModel
@{ ViewData["Title"] = Localizer["Dashboard"].Value; }

<h4 class="mb-4">@Localizer["Dashboard"]</h4>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="card-title small">@Localizer["TotalUsers"]</div>
                <div class="fs-3 fw-bold">@Model.TotalUsers</div>
                <div class="small">+@Model.NewUsersThisWeek @Localizer["ThisWeek"] &nbsp;·&nbsp; +@Model.NewUsersThisMonth @Localizer["ThisMonth"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <div class="card-title small">@Localizer["Listings"]</div>
                <div class="fs-3 fw-bold">@Model.TotalListings</div>
                <div class="small">@Model.ActiveListings @Localizer["ActiveLower"] &nbsp;·&nbsp; @Model.InactiveListings @Localizer["InactiveLower"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-bg-info">
            <div class="card-body">
                <div class="card-title small">@Localizer["Bookings"]</div>
                <div class="fs-3 fw-bold">@Model.TotalBookings</div>
                <div class="small">@Model.BookingsByStatus.GetValueOrDefault(AgriMarket.Modules.Bookings.Enums.BookingStatus.Pending) @Localizer["PendingLower"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-bg-dark">
            <div class="card-body">
                <div class="card-title small">@Localizer["Revenue"]</div>
                <div class="fs-3 fw-bold">&euro;@Model.TotalRevenue.ToString("N2")</div>
                <div class="small">&euro;@Model.TotalPlatformFees.ToString("N2") @Localizer["PlatformFees"] &nbsp;·&nbsp; &euro;@Model.RevenueThisMonth.ToString("N2") @Localizer["ThisMonth"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card @(Model.ActiveDisputes > 0 ? "text-bg-danger" : "text-bg-secondary")">
            <div class="card-body">
                <div class="card-title small">@Localizer["Disputes"]</div>
                <div class="fs-3 fw-bold">@Model.ActiveDisputes @Localizer["ActiveLower"]</div>
                <div class="small">@Model.ResolvedDisputes @Localizer["Resolved"]</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">@Localizer["BookingsByStatus"]</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>@Localizer["Status"]</th><th class="text-end">@Localizer["Count"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (status, count) in Model.BookingsByStatus)
                        {
                            <tr>
                                <td>@status</td>
                                <td class="text-end">@count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">@Localizer["RecentBookings"]</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Client"]</th>
                    <th>@Localizer["Listing"]</th>
                    <th>@Localizer["Status"]</th>
                    <th class="text-end">@Localizer["Price"]</th>
                    <th>@Localizer["Date"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.RecentBookings)
                {
                    <tr>
                        <td>@b.ClientName</td>
                        <td>@b.ListingTitle</td>
                        <td><span class="badge text-bg-secondary">@b.Status</span></td>
                        <td class="text-end">&euro;@b.TotalPrice.ToString("N2")</td>
                        <td>@b.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.RecentBookings.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">@Localizer["NoBookingsYet"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
