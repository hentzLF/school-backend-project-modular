@using AgriMarket.Modules.Bookings.Enums
@model PaymentListViewModel
@{ ViewData["Title"] = Localizer["Payments"].Value; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">@Localizer["Payments"] <span class="badge text-bg-secondary fs-6">@Model.TotalCount</span></h4>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm @(Model.FilterStatus == null ? "btn-secondary" : "btn-outline-secondary")">@Localizer["All"]</a>
        @foreach (var status in Enum.GetValues<PaymentStatus>())
        {
            <a asp-action="Index" asp-route-status="@status"
               class="btn btn-sm @(Model.FilterStatus == status ? "btn-primary" : "btn-outline-primary")">@status</a>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Booking"]</th>
                    <th>@Localizer["Amount"]</th>
                    <th>@Localizer["PlatformFee"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Created"]</th>
                    <th>@Localizer["Released"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td><code>@payment.BookingId.ToString()[..8]…</code></td>
                        <td>&euro;@payment.Amount.ToString("0.00")</td>
                        <td>&euro;@payment.PlatformFee.ToString("0.00")</td>
                        <td>
                            @{
                                var badgeClass = payment.Status switch
                                {
                                    PaymentStatus.Held => "text-bg-warning",
                                    PaymentStatus.Released => "text-bg-success",
                                    PaymentStatus.Refunded => "text-bg-info",
                                    PaymentStatus.Disputed => "text-bg-danger",
                                    _ => "text-bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@payment.Status</span>
                        </td>
                        <td>@payment.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@(payment.ReleasedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Details"]</a>
                        </td>
                    </tr>
                }
                @if (!Model.Payments.Any())
                {
                    <tr><td colspan="7" class="text-muted text-center py-3">@Localizer["NoPaymentsFound"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
